#!/usr/bin/env bash
# Pre-commit hook: block secrets, credentials, and sensitive files.
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

set -euo pipefail

FAIL=0

red() { printf '\033[31m%s\033[0m\n' "$*"; }

STAGED=$(git diff --cached --name-only)

# ── 1. Block specific sensitive files ─────────────────────────────────────────
BLOCKED_FILES=(
    ".env"
    "data/toss_session.json"
)

for f in "${BLOCKED_FILES[@]}"; do
    if echo "$STAGED" | grep -qF "$f"; then
        red "BLOCKED FILE: $f contains credentials/personal data and must not be committed."
        FAIL=1
    fi
done

if echo "$STAGED" | grep -qE '\.(db|sqlite)$'; then
    red "BLOCKED: Database files (*.db, *.sqlite) contain personal financial data and must not be committed."
    FAIL=1
fi

if echo "$STAGED" | grep -qE '^data/[^.]'; then
    red "BLOCKED: data/ directory contains personal financial data and must not be committed."
    FAIL=1
fi

# ── 2. Scan diff for secrets (exclude hook script itself) ─────────────────────
DIFF=$(git diff --cached -- ':!scripts/pre-commit')

check_pattern() {
    local label="$1"
    local pattern="$2"
    if echo "$DIFF" | grep -qE "^\+.*${pattern}"; then
        red "SENSITIVE DATA: $label detected in staged changes."
        FAIL=1
    fi
}

# Anthropic API key
check_pattern "Anthropic API key"    'sk-ant-api[0-9A-Za-z-]+'

# Generic API key real values (20+ char value after =)
check_pattern "API key value"        '(API_KEY|SECRET_KEY|ACCESS_TOKEN)=[A-Za-z0-9_-]{20,}'

# Toss credentials (real phone/password, not placeholder)
check_pattern "Toss phone number"    'TOSS_PHONE=010-[0-9]{3,4}-[0-9]{4}'
check_pattern "Toss password"        'TOSS_PASSWORD=[^y][^\s]{3,}'

# n8n real password (not 'changeme')
check_pattern "n8n auth password"    'N8N_BASIC_AUTH_PASSWORD=[^c][^\s]{3,}'

# Real username in file paths
REAL_PATH='\/Users\/dayeon\.'
check_pattern "real home path"       "$REAL_PATH"

# Korean real name (split to avoid self-match)
REAL_NAME='PRIVATE_NAME'
check_pattern "real name"            "$REAL_NAME"

# ── 3. Report ──────────────────────────────────────────────────────────────────
if [[ $FAIL -eq 1 ]]; then
    echo ""
    red "Commit blocked. Remove the items above before committing."
    echo "If a match is a false positive, check scripts/pre-commit to refine the pattern."
    exit 1
fi

exit 0
